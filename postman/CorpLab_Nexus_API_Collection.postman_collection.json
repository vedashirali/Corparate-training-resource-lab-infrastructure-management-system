{
  "info": {
    "_postman_id": "c1f7b8e2-45a9-4d2b-98f1-corplab001",
    "name": "CorpLab Nexus - Enterprise REST API Collection",
    "description": "Production-grade REST API testing suite for CorpLab Nexus (Spring Boot 3.2.5 + MySQL 8 + Spring Security).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication (Spring Security & RBAC)",
      "item": [
        {
          "name": "POST Login (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"admin\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8088/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8088",
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticates user against MySQL 'users' table using BCrypt password hashing. Issues HTTP-only JSESSIONID."
          }
        },
        {
          "name": "POST Register (New Employee / Trainee)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"sneha.sharma\",\n  \"email\": \"sneha.s@corplab.com\",\n  \"password\": \"Secret@123\",\n  \"role\": \"EMPLOYEE\"\n}"
            },
            "url": {
              "raw": "http://localhost:8088/api/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8088",
              "path": ["api", "auth", "register"]
            },
            "description": "Inserts a new user record into MySQL and creates an audit log entry via ActivityLogRepository."
          }
        },
        {
          "name": "GET Current Profile (/me)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8088/api/auth/profile",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8088",
              "path": ["api", "auth", "profile"]
            },
            "description": "Retrieves the currently authenticated user's profile from the HTTP Session."
          }
        },
        {
          "name": "POST Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "http://localhost:8088/api/auth/logout",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8088",
              "path": ["api", "auth", "logout"]
            },
            "description": "Invalidates the active HTTP session."
          }
        }
      ]
    },
