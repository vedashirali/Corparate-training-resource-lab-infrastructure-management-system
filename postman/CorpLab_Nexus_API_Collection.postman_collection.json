    {
      "name": "5. Lab Booking Requests Workflow",
      "item": [
        {
          "name": "GET All Booking Requests",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8088/api/resource-requests",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8088",
              "path": ["api", "resource-requests"]
            },
            "description": "Returns current reservation requests submitted by students."
          }
        },
        {
          "name": "POST Submit Booking Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceName\": \"NVIDIA RTX 4090 Deep Learning Rig\",\n  \"requesterName\": \"Rahul Sharma\",\n  \"purpose\": \"Spring Boot + Deep Learning Microservice Integration\",\n  \"requestDate\": \"2026-11-25\",\n  \"timeSlot\": \"14:00 - 17:00\"\n}"
            },
            "url": {
              "raw": "http://localhost:8088/api/resource-requests",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8088",
              "path": ["api", "resource-requests"]
            },
            "description": "Creates a new PENDING reservation."
          }
        },
        {
          "name": "PUT Update Request Status (Approve/Reject)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\"\n}"
            },
            "url": {
              "raw": "http://localhost:8088/api/resource-requests/1/status",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8088",
              "path": ["api", "resource-requests", "1", "status"]
            },
            "description": "Administrator workflow action approving a student reservation."
          }
        }
      ]
